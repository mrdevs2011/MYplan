# Public Supabase project configuration (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy Supabase anon keys are also supported as a fallback:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IMPORTANT: OLLAMA_KEY is NOT a Next.js public variable.
# Configure it as a Supabase Edge Function secret; see docs/NOTIFICATIONS_SETUP.md.
